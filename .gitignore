# Code-only whitelist: ignore everything, then allow source files back in
*
!*/
!.gitignore
!.gitattributes
!*.py
!*.ipynb
!*.sql
!*.r
!*.R
!*.sh
!*.ps1
!*.bat
!*.js
!*.ts
!*.html
!*.css
!*.java
!*.scala
!*.yml
!*.yaml
!*.toml
!*.cfg
!*.ini
!*.conf
!*.md
!requirements*.txt
!Dockerfile
!Makefile
!Procfile
!.env.example

# Never commit, even inside allowed folders
**/__pycache__/
**/.ipynb_checkpoints/
**/__MACOSX/
**/venv/
**/.venv/
**/env/
**/site-packages/
**/node_modules/
**/.env
**/.env.*
!**/.env.example
**/data/
**/input/
**/Database_backup/
**/.conda/
**/cdk.out/
**/TOS_DI-*/
**/darknet/
**/labelImg-master/
**/jTessBoxEditor*/
**/Tesseract-OCR/

# Too large or duplicate
/Modular_Code/Zillow-Prod-Code/requirements.txt
/Modular_Code/Zillow-Prod-Code/src/ML_Pipeline/feature_engineering.py
/Modular_Code/Zillow-Prod-Code/src/ML_Pipeline/train_model.py
/Modular_Code/Zillow-Prod-Code/src/ML_Pipeline/utils.py
/Modular_Code/Zillow-Prod-Code/src/engine.py
